# LoboLab - Configuração de API Keys

# Anthropic Claude API
# Obtenha em: https://console.anthropic.com/
CLAUDE_API_KEY=sk-ant-api03-...

# Google Gemini API
# Obtenha em: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=AIza...

# Perplexity AI API
# Obtenha em: https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=pplx-...

# Evolution API (WhatsApp Integration)
# URL da sua instância Evolution API
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=sua-chave-api-evolution
EVOLUTION_INSTANCE_NAME=lobolab

# WhatsApp - Números autorizados (separados por vírgula)
# Deixe vazio para permitir todos os números
# Exemplo: 5511999999999,5521888888888
WHATSAPP_ADMIN_NUMBERS=

# Configurações opcionais
OCR_ENABLED=true
WEB_RESEARCH_ENABLED=true
DEFAULT_OUTPUT_FORMAT=docx
